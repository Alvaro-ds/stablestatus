{
  "name": "stablestatus",
  "version": "0.1.0",
  "description": "Open dataset mapping stablecoin contracts to their MiCA status",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "ingest": "pnpm build && node dist/cli/ingest.js",
    "changelog": "pnpm build && node dist/cli/changelog.js",
    "gate:check": "pnpm build && node dist/cli/gate-check.js",
    "generate-variants": "node --experimental-strip-types tests/scripts/generate-variants.ts"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "zod": "^4.6.7"
  }
}
